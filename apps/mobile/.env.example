# Copy this file (or the root .env.example) to apps/mobile/.env.local.
# EXPO_PUBLIC values are bundled in the app; never use privileged credentials.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Android localhost requires adb reverse tcp:8000 tcp:8000.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DATA_MODE=supabase
EXPO_PUBLIC_MAP_RENDERER=leaflet
# Optional provider; use HTTPS and follow its usage policy.
# EXPO_PUBLIC_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=Your provider
# Android custom native builds only, restricted client key:
# GOOGLE_MAPS_ANDROID_API_KEY=
# Explicit planned local persistence: local. Routing still requires FastAPI.

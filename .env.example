# Copy to apps/mobile/.env.local. Values are public and bundled; never put secrets here.
# localhost works on Android with adb reverse tcp:8000 tcp:8000.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Without ADB reverse, Android Studio emulator can use http://10.0.2.2:8000.
# A physical device on Wi-Fi must use the computer's LAN address (see README).
# Supabase mode is the default. Enable anonymous sign-ins on the project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Explicit local-only fallback: local. Never activated automatically on failure.
EXPO_PUBLIC_DATA_MODE=supabase
# Default key-free Leaflet/OSM; optional credentialed native renderer: native.
EXPO_PUBLIC_MAP_RENDERER=leaflet
# Optional alternative HTTPS raster provider and required additional attribution.
# EXPO_PUBLIC_MAP_TILE_URL=https://your-provider.example/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=Your provider
# Android custom native builds only; public key restricted by package + SHA-1.
# GOOGLE_MAPS_ANDROID_API_KEY=

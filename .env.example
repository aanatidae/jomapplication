# Copy to apps/mobile/.env.local. Values are public and bundled; never put secrets here.
# localhost works on Android with adb reverse tcp:8000 tcp:8000.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Without ADB reverse, Android Studio emulator can use http://10.0.2.2:8000.
# A physical device on Wi-Fi must use the computer's LAN address (see README).
# Supabase and Google Maps credentials will be documented in their own phases.
